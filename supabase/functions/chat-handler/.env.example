# Environment Variables for Chat Handler Edge Function
# Copy this file to .env.local for local development
# For production, set these in Supabase Dashboard > Edge Functions > Settings

# Supabase Configuration
# Get these from: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# N8N Webhook Configuration
# Get this from: N8N > Workflow > Webhook node > Production URL
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/croco-chat

# Environment (optional)
# Values: development, staging, production
ENVIRONMENT=production
