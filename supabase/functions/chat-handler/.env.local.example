# Local Development Environment Variables
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# Supabase Configuration (Local Development)
# For local development, use your Supabase project credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# N8N Webhook Configuration (Local Development)
# Use your local N8N instance or development webhook URL
N8N_WEBHOOK_URL=http://localhost:5678/webhook/croco-chat

# Environment
ENVIRONMENT=development
