    {
      "parameters": {
        "operation": "upload",
        "bucket": {
          "__rl": true,
          "value": "podcasts",
          "mode": "list",
          "cachedResultName": "podcasts"
        },
        "fileName": "={{ $now.format('yyyy-MM-dd') }}/{{ $('准备上下文').item.json.character.slug }}_{{ $('准备上下文').item.json.user.id }}.mp3",
        "options": {
          "contentType": "audio/mpeg"
        }
      },
      "id": "upload-audio",
      "name": "上传音频",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1800,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "your-supabase-credentials-id",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 获取所有需要的数据\nconst context = $('准备上下文').item.json;\nconst article = $('AI 生成文章').item.json.output;\nconst audioUpload = $input.item.json;\n\n// 生成标题\nconst title = `${context.character.name}的${context.expertise}小课堂 - ${$now.format('yyyy年MM月dd日')}`;\n\n// 生成摘要（取文章前100字）\nconst summary = article.substring(0, 100) + '...';\n\n// 生成标签\nconst tags = [\n  context.expertise,\n  context.ageStage.name,\n  ...context.user.interests || []\n];\n\n// 目标年级\nconst targetGrades = [context.user.grade || '全年级'];\n\n// 音频 URL\nconst audioUrl = audioUpload.publicUrl || audioUpload.path;\n\n// 估算音频时长（按每分钟150字计算）\nconst durationSeconds = Math.ceil((article.length / 150) * 60);\n\nreturn {\n  json: {\n    title: title,\n    content: article,\n    audio_url: audioUrl,\n    summary: summary,\n    tags: tags,\n    target_grades: targetGrades,\n    duration_seconds: durationSeconds,\n    is_published: true,\n    publish_date: $now.format('yyyy-MM-dd'),\n    // 保存上下文用于后续插入 user_podcast_feeds\n    user_id: context.user.id,\n    character_id: context.character.id\n  }\n};"
      },
      "id": "prepare-podcast-data",
      "name": "准备播客数据",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        300
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "podcasts",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "title": "={{ $json.title }}",
            "content": "={{ $json.content }}",
            "audio_url": "={{ $json.audio_url }}",
            "summary": "={{ $json.summary }}",
            "tags": "={{ $json.tags }}",
            "target_grades": "={{ $json.target_grades }}",
            "duration_seconds": "={{ $json.duration_seconds }}",
            "is_published": "={{ $json.is_published }}",
            "publish_date": "={{ $json.publish_date }}"
          }
        },
        "options": {
          "returnFields": "id"
        }
      },
      "id": "insert-podcast",
      "name": "保存播客",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2200,
