          "value": {
            "user_id": "={{ $('准备播客数据').item.json.user_id }}",
            "podcast_id": "={{ $json.id }}",
            "is_read": false,
            "pushed_at": "={{ $now.toISO() }}"
          }
        }
      },
      "id": "insert-feed",
      "name": "保存推送记录",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2400,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "your-supabase-credentials-id",
          "name": "Supabase account"
        }
      }
    },
    {
