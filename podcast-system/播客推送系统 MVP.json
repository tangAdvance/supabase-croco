    {
      "parameters": {
        "jsCode": "// 获取返回的文本数据\nlet rawData = $input.first().json.data;\n\n// 按换行符分割多个JSON对象\nconst jsonLines = rawData.split('\\n').filter(line => line.trim() !== '');\n\nconsole.log('找到', jsonLines.length, '个JSON对象');\n\n// 存储所有音频片段\nlet audioSegments = [];\n\n// 解析每个JSON对象\nfor (const line of jsonLines) {\n  try {\n    const jsonObj = JSON.parse(line);\n    \n    // 检查是否成功\n    if (jsonObj.code === 0 && jsonObj.data) {\n      audioSegments.push(jsonObj.data);\n      console.log('成功解析片段，长度:', jsonObj.data.length);\n    }\n  } catch (error) {\n    console.log('解析JSON失败:', error, '内容:', line.substring(0, 50));\n  }\n}\n\nconsole.log('总共获取到', audioSegments.length, '个音频片段');\n\n// 合并所有base64音频数据\nconst combinedAudioBase64 = audioSegments.join('');\n\nconsole.log('合并后的base64总长度:', combinedAudioBase64.length);\n\n// 生成文件名\nconst fileName = `tts_${Date.now()}.mp3`;\n\n// 返回二进制格式\nreturn {\n  json: {\n    fileName: fileName,\n    segmentCount: audioSegments.length,\n    totalSize: combinedAudioBase64.length\n  },\n  binary: {\n    data: {\n      data: combinedAudioBase64,\n      mimeType: 'audio/mpeg',\n      fileName: fileName,\n      fileExtension: 'mp3'\n    }\n  }\n};"
      },
