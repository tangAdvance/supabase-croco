    {
      "parameters": {
        "jsCode": "// 获取角色和用户信息\nconst character = $('Loop Over Items').first().json.id;\nconst user = $('查询所有用户1').first().json;\nconst memories = $input.all();\n\n// 判断用户年龄阶段\nfunction getAgeStage(age) {\n  if (age >= 6 && age <= 9) {\n    return {\n      stage: 'beginner',\n      name: '启蒙期',\n      style: '简单易懂，使用童话故事、动物比喻和生动的画面感。多用短句，避免复杂概念。'\n    };\n  } else if (age >= 10 && age <= 12) {\n    return {\n      stage: 'explorer',\n      name: '探索期',\n      style: '逻辑推理，使用生活案例和实验思维。引导思考，适当使用科学术语并解释。'\n    };\n  } else if (age >= 13 && age <= 15) {\n    return {\n      stage: 'advanced',\n      name: '深化期',\n      style: '跨学科关联，抽象思维和深度类比。使用专业术语，引导批判性思考。'\n    };\n  } else {\n    return {\n      stage: 'explorer',\n      name: '探索期',\n      style: '逻辑推理，使用生活案例和实验思维。引导思考，适当使用科学术语并解释。'\n    };\n  }\n}\n\n// 获取年龄阶段\nconst ageStage = getAgeStage(user.age || 10);\n\n// 格式化用户记忆\nlet memoriesText = '';\nif (memories.length > 0) {\n  memoriesText = memories.map(m => `- ${m.json.memory_key}: ${m.json.memory_value}`).join('\\n');\n} else {\n  memoriesText = '（暂无记忆）';\n}\n\n// 构建 Tavily 搜索查询\nconst expertise = character.expertise && character.expertise.length > 0 \n  ? character.expertise[0] \n  : '科学知识';\n\nconst interests = user.interests && user.interests.length > 0\n  ? user.interests.join('、')\n  : '学习';\n\nconst searchQuery = `${expertise} ${interests} 儿童教育 最新内容`;\n\nreturn {\n  json: {\n    character: character,\n    user: user,\n    ageStage: ageStage,\n    memoriesText: memoriesText,\n    searchQuery: searchQuery,\n    expertise: expertise,\n    interests: interests\n  }\n};"
      },
      "id": "c7eae7bf-5d7b-4a7a-9765-022c669a0c87",
      "name": "准备上下文1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
