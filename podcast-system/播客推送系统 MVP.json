    {
      "parameters": {
        "jsCode": "// 获取所有需要的数据\nconst context = $('准备上下文1').first().json;\nconst article = $('AI 生成文章1').first().json.output;\nconst audioUpload = $input.first().json;\nconst character = $('Loop Over Items').first().json;\n\n// 生成标题\nconst title = `${character.name}的${context.expertise}小课堂 - ${$now.toFormat('yyyy年MM月dd日')}`;\n\n// 生成摘要（取文章前100字）\nconst summary = article.substring(0, 100) + '...';\n\n// 生成标签\nconst tags = [\n  context.expertise,\n  context.ageStage.name,\n  ...context.user.interests || []\n];\n// 目标年级\nconst targetGrades = [context.user.grade || '全年级'];\n\nconst fiexurl = \"https://riwghatatpylyrejmlvi.supabase.co/storage/v1/object/public/\"; \n// 音频 URL\nconst audioUrl = fiexurl + audioUpload.Key;\n// 封面图片地址\nconst cover_image_url = fiexurl + $('公共存储桶存储封面').first().json.Key;\n\n\n// 估算音频时长（按每分钟150字计算）\nconst durationSeconds = Math.ceil((article.length / 150) * 60);\n\nreturn {\n  json: {\n    title: title,\n    content: article,\n    audio_url: audioUrl,\n    cover_image_url: cover_image_url,\n    summary: summary,\n    tags: tags,\n    target_grades: targetGrades,\n    duration_seconds: durationSeconds,\n    is_published: true,\n    publish_date: $now.toFormat('yyyy-MM-dd'),\n    // 保存上下文用于后续插入 user_podcast_feeds\n    user_id: context.user.id,\n    character_id: character.id\n  }\n};"
      },
